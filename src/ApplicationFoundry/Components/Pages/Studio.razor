    private async Task SaveProfileAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (profile.Id == 0) db.CandidateProfiles.Add(profile); else db.CandidateProfiles.Update(profile);
        await db.SaveChangesAsync();
        message = "Profile saved.";
        await ReloadAsync();
    }

    private async Task AddEvidenceAsync()
    {
        if (profile.Id == 0) { message = "Save the profile before adding evidence."; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        newEvidence.ProfileId = profile.Id;
        db.EvidenceItems.Add(newEvidence);
        await db.SaveChangesAsync();
        newEvidence = new EvidenceItem();
        message = "Evidence added.";
        await ReloadAsync();
    }

    private async Task AddJobAsync()
    {
        if (profile.Id == 0 || profile.Evidence.Count == 0) { message = "Save a profile and at least one evidence item first."; return; }
        newJob.UserId = userId;
        newJob.Status = OpportunityStatus.ReadyForReview;
        var fit = FitScorer.Score(profile, newJob);
        newJob.FitScore = fit.Score;
        newJob.FitExplanation = fit.Explanation;
        newJob.Documents.Add(new DocumentVersion { Kind = CareerDocumentKind.Resume, Version = 1, Content = Documents.DraftResume(profile, newJob) });
        newJob.Documents.Add(new DocumentVersion { Kind = CareerDocumentKind.CoverLetter, Version = 1, Content = Documents.DraftCoverLetter(profile, newJob) });
        newJob.Activities.Add(new ApplicationActivity { Action = "drafted", Note = "Local fit analysis and document drafts created." });
        await using var db = await DbFactory.CreateDbContextAsync();
        db.JobOpportunities.Add(newJob);
        await db.SaveChangesAsync();
        newJob = new JobOpportunity { UserId = userId };
        message = "Opportunity analyzed; review both drafts before approval.";
        await ReloadAsync();
    }

    private async Task SearchJobsAsync()
    {
        isSearching = true;
        message = "";
        try
        {
            var filters = new JobSearchFilters(searchKeywords, minimumSearchFitPercent / 100f);
            discoveredJobs = searchSource switch
            {
                "greenhouse" => await GreenhouseDiscovery.FindMatchesAsync(profile, greenhouseBoardToken, greenhouseEmployer, filters, searchLocation),
                "lever" => await LeverDiscovery.FindMatchesAsync(profile, leverSiteToken, leverEmployer, filters, searchLocation, leverRegion),
                _ => await JobDiscovery.FindMatchesAsync(profile, filters)
            };
            if (discoveredJobs.Count == 0) message = "No postings matched these filters right now. Try broader filters or import a posting below.";
        }
        catch (ArgumentException exception)
        {
            message = exception.Message;
        }
        catch (HttpRequestException exception) when (searchSource == "greenhouse" && exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            message = "That Greenhouse board was not found. Check the token from the employer's board URL.";
        }
        catch (HttpRequestException exception) when (searchSource == "lever" && exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            message = "That Lever site was not found. Check its site token and region.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidDataException)
        {
            message = "Job search is temporarily unavailable. Try again later or import a posting below.";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task DraftDiscoveredJobAsync(DiscoveredJob result)
    {
        newJob = new JobOpportunity
        {
            RoleTitle = result.RoleTitle,
            Organization = result.Organization,
            SourceUrl = result.SourceUrl,
            Description = result.Description
        };
        await AddJobAsync();
        discoveredJobs = [];
    }

    private async Task ApproveAsync(int documentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var document = await db.DocumentVersions.Join(db.JobOpportunities, d => d.JobOpportunityId, j => j.Id, (d, j) => new { d, j.UserId })
            .SingleAsync(item => item.d.Id == documentId && item.UserId == userId);
        document.d.ApprovedAt = DateTimeOffset.UtcNow;
        document.d.ApprovedByUserId = userId;
        await db.SaveChangesAsync();
        message = "Version approved and available for export.";
        await ReloadAsync();
    }

    private Task ExportDocxAsync(int documentId) => ExportAsync(documentId, "docx");
    private Task ExportPdfAsync(int documentId) => ExportAsync(documentId, "pdf");

    private async Task ExportAsync(int documentId, string format)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var document = await db.DocumentVersions
            .Join(db.JobOpportunities, version => version.JobOpportunityId, job => job.Id,
                (version, job) => new { Version = version, job.UserId })
            .SingleOrDefaultAsync(item => item.Version.Id == documentId && item.UserId == userId);
        if (document?.Version.ApprovedAt is null)
        {
            message = "Approve this document version before export.";
            return;
        }
        var content = format == "pdf" ? Documents.ToPdf(document.Version.Content) : Documents.ToDocx(document.Version.Content);
        var mediaType = format == "pdf" ? "application/pdf" : "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        try
        {
            var saved = await ClientExport.SaveAsync(content, $"application-{documentId}.{format}", mediaType);
            message = saved ? "Document saved." : "Save canceled.";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            message = "The document could not be saved at that location.";
        }
    }

    private async Task MarkSubmittedAsync(int jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.Documents)
            .Include(item => item.FormPlan).ThenInclude(plan => plan!.Entries)
            .SingleAsync(item => item.Id == jobId && item.UserId == userId);
        if (job.Status == OpportunityStatus.Submitted)
        {
            message = "This opportunity is already recorded as submitted.";
            return;
        }
        if (job.Documents.Count < 2 || job.Documents.Any(document => document.ApprovedAt is null))
        {
            message = "Approve both document versions before recording a manual submission.";
            return;
        }
        if (job.FormPlan?.Mode == FormSubmissionMode.ApproveEachSubmission && !SubmissionApproval.IsCurrent(job))
        {
            message = "Approve the current submission packet before recording submission.";
            return;
        }
        if (job.FormPlan?.Entries.Count > 0 && !formDrafts[jobId].ConfirmSentEntries)
        {
            message = "Confirm that the recorded form values are exactly what you sent before recording submission.";
            return;
        }
        var submittedAt = DateTimeOffset.UtcNow;
        if (job.FormPlan is not null)
        {
            foreach (var entry in job.FormPlan.Entries.Where(entry => entry.SubmittedAt is null))
                entry.SubmittedAt = submittedAt;
        }
        job.Status = OpportunityStatus.Submitted;
        job.Activities.Add(new ApplicationActivity { Action = "submitted", Note = "User confirmed a manual external submission and any recorded form values." });
        await db.SaveChangesAsync();
        message = "Manual submission recorded. No external form was automated.";
        await ReloadAsync();
    }

    private async Task ApproveSubmissionAsync(int jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.Documents)
            .Include(item => item.FormPlan).ThenInclude(plan => plan!.Entries)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job?.FormPlan?.Mode != FormSubmissionMode.ApproveEachSubmission || job.Status == OpportunityStatus.Submitted)
            return;
        if (job.Documents.Count < 2 || job.Documents.Any(document => document.ApprovedAt is null))
        {
            message = "Approve both document versions before approving this submission packet.";
            return;
        }
        job.FormPlan.SubmissionApprovalFingerprint = SubmissionApproval.Fingerprint(job);
        job.FormPlan.SubmissionApprovedAt = DateTimeOffset.UtcNow;
        job.Activities.Add(new ApplicationActivity { Action = "submission-approved", Note = "Applicant approved the current document versions and recorded form values for this opportunity." });
        await db.SaveChangesAsync();
        message = "Current submission packet approved locally. No employer form was sent.";
        await ReloadAsync();
    }

    private async Task ScheduleFollowUpAsync(int jobId)
    {
        var draft = followUpDrafts[jobId];
        if (draft.DueOn is null || draft.DueOn.Value.Date < DateTime.Today)
        {
            message = "Choose today or a future date for the next follow-up.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job is null) return;
        job.NextFollowUpOn = DateOnly.FromDateTime(draft.DueOn.Value);
        await db.SaveChangesAsync();
        message = "Follow-up date saved locally.";
        await ReloadAsync();
    }

    private async Task ClearFollowUpAsync(int jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job is null) return;
        job.NextFollowUpOn = null;
        await db.SaveChangesAsync();
        message = "Follow-up date cleared.";
        await ReloadAsync();
    }

    private async Task RecordFollowUpAsync(int jobId)
    {
        var note = followUpDrafts[jobId].Note.Trim();
        if (note.Length is < 1 or > 1000)
        {
            message = "Enter a follow-up note of 1000 characters or fewer.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job is null) return;
        job.Activities.Add(new ApplicationActivity { Action = "follow-up", Note = note });
        job.NextFollowUpOn = null;
        await db.SaveChangesAsync();
        message = "Follow-up recorded. Schedule another date if needed.";
        await ReloadAsync();
    }

    private enum ProfileFact { FullName, Email, Phone }

    private void UseProfileFact(int jobId, ProfileFact field)
    {
        var answer = field switch
        {
            ProfileFact.FullName => profile.DisplayName,
            ProfileFact.Email => profile.Email,
            ProfileFact.Phone => profile.Phone,
            _ => ""
        };
        if (string.IsNullOrWhiteSpace(answer))
        {
            message = $"Save a {field.ToString().ToLowerInvariant()} in your profile first.";
            return;
        }
        var draft = formDrafts[jobId];
        draft.FieldLabel = field == ProfileFact.FullName ? "Full name" : field.ToString();
        draft.Answer = answer;
        draft.Source = "Saved profile";
        message = "Review this suggested answer before saving it.";
    }

    private bool ValidateFormPlan(FormPlanDraft draft)
    {
        if (!Enum.IsDefined(draft.Mode))
        {
            message = "Choose a submission preference.";
            return false;
        }
        if (draft.Rules.Length > 2000 ||
            (draft.Mode == FormSubmissionMode.AutomaticWithinRules && string.IsNullOrWhiteSpace(draft.Rules)))
        {
            message = "Enter submission rules of 2000 characters or fewer for automatic mode.";
            return false;
        }
        return true;
    }

    private void CheckAutomaticRules(int jobId)
    {
        var job = jobs.Single(item => item.Id == jobId);
        ruleResults[jobId] = AutomaticSubmissionRuleEvaluator.Evaluate(job);
    }

    private async Task SaveFormPlanAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        if (!ValidateFormPlan(draft)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job is null) return;
        job.FormPlan ??= new ApplicationFormPlan();
        job.FormPlan.Mode = draft.Mode;
        job.FormPlan.Rules = draft.Rules.Trim();
        job.FormPlan.UpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        message = "Submission preference saved locally. Employer form submission is not automated yet.";
        await ReloadAsync();
    }

    private async Task AddPreparedAnswerAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        if (!ValidateFormPlan(draft)) return;
        var field = draft.FieldLabel.Trim();
        var answer = draft.Answer.Trim();
        var source = draft.Source.Trim();
        if (field.Length is < 1 or > 200 || answer.Length is < 1 or > 4000 || source.Length is < 1 or > 240)
        {
            message = "Enter a form field (up to 200 characters), answer (up to 4000), and source (up to 240).";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job is null) return;
        job.FormPlan ??= new ApplicationFormPlan();
        job.FormPlan.Mode = draft.Mode;
        job.FormPlan.Rules = draft.Rules.Trim();
        job.FormPlan.UpdatedAt = DateTimeOffset.UtcNow;
        job.FormPlan.Answers.Add(new ApplicationFormAnswer
        {
            FieldLabel = field,
            Answer = answer,
            Source = source,
            ReviewedAt = DateTimeOffset.UtcNow
        });
        await db.SaveChangesAsync();
        message = "Reviewed answer saved locally. No employer form was filled or submitted.";
        await ReloadAsync();
    }

    private async Task RecordEnteredFieldAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        var field = draft.EntryFieldLabel.Trim();
        var value = draft.EntryValue.Trim();
        if (field.Length is < 1 or > 200 || value.Length is < 1 or > 4000)
        {
            message = "Enter a field (up to 200 characters) and its exact value (up to 4000).";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        if (job is null || job.Status == OpportunityStatus.Submitted) return;
        job.FormPlan ??= new ApplicationFormPlan();
        job.FormPlan.Entries.Add(new ApplicationFormEntry
        {
            FieldLabel = field,
            ValueEntered = value,
            EnteredAt = DateTimeOffset.UtcNow
        });
        await db.SaveChangesAsync();
        message = "Entered value recorded locally. It is not marked as sent.";
        await ReloadAsync();
    }

    private async Task RemoveEnteredFieldAsync(int jobId, int entryId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan).ThenInclude(plan => plan!.Entries)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        var entry = job?.FormPlan?.Entries.SingleOrDefault(item => item.Id == entryId);
        if (entry is null || entry.SubmittedAt is not null || job!.Status == OpportunityStatus.Submitted) return;
        db.ApplicationFormEntries.Remove(entry);
        await db.SaveChangesAsync();
        message = "Unsent entered value removed.";
        await ReloadAsync();
    }

    private void PreviewFormMatch(int jobId)
    {
        var draft = formDrafts[jobId];
        draft.FormPreview = null;
        draft.PreviewFingerprint = "";
        draft.FormAuthorization = null;
        if (!EmployerFormSnapshotCodec.TryParse(draft.SnapshotJson, out var snapshot, out var error))
        {
            message = error;
            return;
        }
        var job = jobs.Single(job => job.Id == jobId);
        draft.FormPreview = EmployerFormFillPlanner.Prepare(job, snapshot!);
        draft.PreviewFingerprint = FormFillAuthorizer.Authorize(job, snapshot!)?.Fingerprint ?? "";
        message = draft.FormPreview.IsComplete
            ? "Reviewed answers match this form snapshot. No values were entered or sent."
            : "The form match is blocked; review the reasons below.";
    }

    private async Task AuthorizeFormMatchAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        draft.FormAuthorization = null;
        if (draft.FormPreview?.IsComplete != true || draft.PreviewFingerprint.Length == 0 ||
            !EmployerFormSnapshotCodec.TryParse(draft.SnapshotJson, out var snapshot, out _))
        {
            message = "Preview this form and its proposed values again before authorizing.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan).ThenInclude(plan => plan!.Answers)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        var authorization = job is null ? null : FormFillAuthorizer.Authorize(job, snapshot!);
        if (authorization is null || !string.Equals(authorization.Fingerprint, draft.PreviewFingerprint, StringComparison.Ordinal))
        {
            message = "The form or reviewed answers changed. Preview the current match before authorizing.";
            return;
        }
        draft.FormAuthorization = authorization;
        message = "Exact form match authorized locally for ten minutes. No values were entered or sent.";
    }

    private bool IsFormMatchAuthorized(JobOpportunity job)
    {
        var draft = formDrafts[job.Id];
        return EmployerFormSnapshotCodec.TryParse(draft.SnapshotJson, out var snapshot, out _) &&
            FormFillAuthorizer.IsCurrent(job, snapshot!, draft.FormAuthorization);
    }

    private async Task CopyApprovedFillPacketAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        if (!EmployerFormSnapshotCodec.TryParse(draft.SnapshotJson, out var snapshot, out _))
        {
            draft.FormAuthorization = null;
            message = "The form snapshot changed. Preview and authorize it again.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan).ThenInclude(plan => plan!.Answers)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        var packet = job is null ? null : BrowserFormFillPacketBuilder.Create(job, snapshot!, draft.FormAuthorization);
        if (packet is null)
        {
            draft.FormAuthorization = null;
            message = "The authorization expired or the reviewed packet changed. Preview and authorize it again.";
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", BrowserFormFillPacketBuilder.ToJson(packet));
            message = "Approved form values copied for this exact page. Use the fill bookmarklet before authorization expires, then inspect and record what was entered. Nothing was submitted.";
        }
        catch (JSException)
        {
            message = "The browser could not access the clipboard. No form values were copied or entered.";
        }
    }

    private async Task PasteBrowserReceiptAsync(int jobId)
    {
        try
        {
            formDrafts[jobId].BrowserReceiptJson = await JS.InvokeAsync<string>("navigator.clipboard.readText");
            await PreviewBrowserReceiptAsync(jobId);
        }
        catch (JSException)
        {
            message = "Clipboard access was unavailable. Paste the browser receipt into the box instead.";
        }
    }

    private async Task PreviewBrowserReceiptAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        draft.ReceiptPreviewValues = null;
        draft.ReceiptPreviewJson = "";
        draft.ConfirmObservedEntries = false;
        if (!EmployerFormSnapshotCodec.TryParse(draft.SnapshotJson, out var snapshot, out _))
        {
            message = "Preview and authorize the current employer form before reviewing its receipt.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.FormPlan).ThenInclude(plan => plan!.Answers)
            .SingleOrDefaultAsync(item => item.Id == jobId && item.UserId == userId);
        var packet = job is null ? null : BrowserFormFillPacketBuilder.Create(job, snapshot!, draft.FormAuthorization);
        if (packet is null || !BrowserFormFillReceiptValidator.TryMatch(draft.BrowserReceiptJson, packet, out var entered, out _))
        {
            message = "The browser receipt does not match the current authorized form. Preview and authorize again if it changed.";
            return;
        }
        draft.ReceiptPreviewValues = entered;
        draft.ReceiptPreviewJson = draft.BrowserReceiptJson;
        message = "Review the values reported by the browser against the employer page before recording them.";
    }

    private async Task RecordBrowserReceiptAsync(int jobId)
    {
        var draft = formDrafts[jobId];
        if (draft.ReceiptPreviewValues is not { Count: > 0 } ||
            draft.BrowserReceiptJson != draft.ReceiptPreviewJson ||
            !EmployerFormSnapshotCodec.TryParse(draft.SnapshotJson, out var snapshot, out _))
        {
            message = "The receipt changed. Review it again before recording.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var result = await BrowserFormEntryRecorder.RecordAsync(db, jobId, userId, snapshot!,
            draft.FormAuthorization, draft.BrowserReceiptJson, draft.ConfirmObservedEntries);
        message = result.Reason;
        if (result.Recorded)
            await ReloadAsync();
    }

    private sealed class FormPlanDraft
    {
        public FormSubmissionMode Mode { get; set; }
        public string Rules { get; set; } = "";
        public string FieldLabel { get; set; } = "";
        public string Answer { get; set; } = "";
        public string Source { get; set; } = "";
        public string EntryFieldLabel { get; set; } = "";
        public string EntryValue { get; set; } = "";
        public bool ConfirmSentEntries { get; set; }
        public string SnapshotJson { get; set; } = "";
        public FormFillProposal? FormPreview { get; set; }
        public string PreviewFingerprint { get; set; } = "";
        public FormFillAuthorization? FormAuthorization { get; set; }
        public string BrowserReceiptJson { get; set; } = "";
        public string ReceiptPreviewJson { get; set; } = "";
        public IReadOnlyList<ProposedFieldValue>? ReceiptPreviewValues { get; set; }
        public bool ConfirmObservedEntries { get; set; }
    }

    private sealed class FollowUpDraft
    {
        public DateTime? DueOn { get; set; }
        public string Note { get; set; } = "";
    }
}
