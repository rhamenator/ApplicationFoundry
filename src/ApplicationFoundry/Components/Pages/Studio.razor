    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        newJob.UserId = userId;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        profile = await db.CandidateProfiles.Include(item => item.Evidence).SingleOrDefaultAsync(item => item.UserId == userId)
            ?? new CandidateProfile { UserId = userId };
        jobs = (await db.JobOpportunities.Include(job => job.Documents).Include(job => job.Activities)
            .Include(job => job.FormPlan).ThenInclude(plan => plan!.Answers)
            .Include(job => job.FormPlan).ThenInclude(plan => plan!.Entries)
            .Where(job => job.UserId == userId).ToListAsync())
            .OrderByDescending(job => job.ImportedAt).ToList();
        var previousDrafts = formDrafts;
        formDrafts = jobs.ToDictionary(job => job.Id, job => new FormPlanDraft
        {
            Mode = job.FormPlan?.Mode ?? FormSubmissionMode.SubmitPersonally,
            Rules = job.FormPlan?.Rules ?? "",
            SnapshotJson = previousDrafts.TryGetValue(job.Id, out var previous) ? previous.SnapshotJson : ""
        });
        ruleResults.Clear();
        followUpDrafts = jobs.ToDictionary(job => job.Id, job => new FollowUpDraft
        {
            DueOn = job.NextFollowUpOn?.ToDateTime(TimeOnly.MinValue)
        });
        sourceDocuments = (await db.CandidateSourceDocuments.Where(source => source.UserId == userId).ToListAsync())
            .OrderByDescending(source => source.ImportedAt).ToList();
        legacyImportBatches = (await db.LegacyEvidenceImportBatches.Where(batch => batch.UserId == userId).ToListAsync())
            .OrderByDescending(batch => batch.ImportedAt).ToList();
    }

    private async Task PreviewSourceDocumentAsync(InputFileChangeEventArgs eventArgs)
    {
        pendingSource = null;
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(CandidateDocumentImportService.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            pendingSource = await DocumentImporter.ExtractAsync(file.Name, sourceKind, buffer.ToArray());
            message = "Review the extracted text before saving it.";
        }
        catch (DocumentImportException exception)
        {
            message = exception.Code switch
            {
                "SIZE_LIMIT" => "Choose a nonempty file no larger than 2 MB.",
                "NO_TEXT" => "No text was found. Scanned PDFs need OCR before they can be imported.",
                _ => "This document could not be read. Check that it is a valid TXT, DOCX, or text-based PDF."
            };
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or ArgumentException)
        {
            message = "Choose a valid TXT, DOCX, or text-based PDF no larger than 2 MB.";
        }
    }

    private async Task PreviewLegacyCsvAsync(InputFileChangeEventArgs eventArgs)
    {
        pendingLegacyCsv = null;
        legacyMappedPreview = null;
        legacyImportPlan = null;
        legacyImportConfirmed = false;
        legacyColumnDrafts = [];
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(LegacyAccessCsvPreviewService.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            pendingLegacyCsv = LegacyCsvPreviewer.Preview(file.Name, buffer.ToArray());
            legacyColumnDrafts = pendingLegacyCsv.Columns.Select(column => new LegacyColumnDraft { Column = column }).ToList();
            message = "Review the table columns and sample records before mapping.";
        }
        catch (LegacyAccessCsvPreviewException exception)
        {
            message = exception.Code switch
            {
                "UTF8_REQUIRED" => "Export this Access table as UTF-8 CSV and try again.",
                "SIZE_LIMIT" or "LIMIT" => "Choose a CSV up to 8 MB with at most 40 columns and 5,000 records.",
                _ => "The CSV could not be previewed. Check its header, quoting, and row widths."
            };
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or ArgumentException)
        {
            message = "Choose a CSV up to 8 MB with at most 40 columns and 5,000 records.";
        }
    }

    private void ClearLegacyMappingPreview()
    {
        legacyMappedPreview = null;
        legacyImportPlan = null;
        legacyImportConfirmed = false;
    }

    private void PreviewLegacyMapping()
    {
        if (pendingLegacyCsv is null) return;
        legacyImportPlan = null;
        legacyImportConfirmed = false;
        try
        {
            legacyMappedPreview = LegacyCsvPreviewer.PreviewMapping(
                pendingLegacyCsv, legacyColumnDrafts.Select(draft => draft.Target).ToArray());
            message = "Review the mapped sample. No records have been imported.";
        }
        catch (LegacyAccessCsvPreviewException exception)
        {
            legacyMappedPreview = null;
            message = exception.Code switch
            {
                "MAPPING_DUPLICATE" => "Choose each destination field only once.",
                "MAPPING_EMPTY" => "Choose at least one destination field to preview.",
                _ => "Check the column mapping and try again."
            };
        }
    }

    private void PrepareLegacyEvidenceImport()
    {
        if (pendingLegacyCsv is null || legacyMappedPreview is null) return;
        legacyImportConfirmed = false;
        try
        {
            legacyImportPlan = LegacyCsvPreviewer.PrepareEvidenceImport(
                pendingLegacyCsv, legacyColumnDrafts.Select(draft => draft.Target).ToArray());
            message = "Review the evidence import plan. Nothing has been saved.";
        }
        catch (LegacyAccessCsvPreviewException exception)
        {
            legacyImportPlan = null;
            message = exception.Code switch
            {
                "EVIDENCE_MAPPING" => "For evidence import, map exactly one column to Evidence claim and ignore the others.",
                "CLAIM_LENGTH" => "An evidence claim exceeds 240 characters. Edit the CSV before importing it.",
                "NO_CLAIMS" => "The mapped column has no nonempty evidence claims.",
                _ => "Check the evidence mapping and try again."
            };
        }
    }

    private async Task ImportLegacyEvidenceAsync()
    {
        if (!legacyImportConfirmed || legacyImportPlan is null || profile.Id == 0 || legacyImportBusy) return;
        legacyImportBusy = true;
        try
        {
            var batch = await EvidenceImporter.ImportAsync(userId, legacyImportPlan);
            pendingLegacyCsv = null;
            legacyMappedPreview = null;
            legacyImportPlan = null;
            legacyImportConfirmed = false;
            legacyColumnDrafts = [];
            await ReloadAsync();
            message = $"Imported {batch.ClaimCount} evidence claims. You can undo this batch below.";
        }
        catch (LegacyEvidenceImportException exception)
        {
            message = exception.Code switch
            {
                "PROFILE_REQUIRED" => "Save your profile before importing evidence.",
                "CLAIM_EXISTS" => "A proposed claim already exists in your evidence library. Review the CSV and try again.",
                _ => "The import plan is no longer valid. Preview the CSV again."
            };
        }
        finally { legacyImportBusy = false; }
    }

    private async Task UndoLegacyEvidenceImportAsync(int batchId)
    {
        if (legacyImportBusy) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Undo this import? All evidence claims from this batch, including any edits, will be removed.");
        if (!confirmed) return;
        legacyImportBusy = true;
        try
        {
            var removed = await EvidenceImporter.UndoAsync(userId, batchId);
            await ReloadAsync();
            message = $"Removed {removed} imported evidence claims.";
        }
        catch (LegacyEvidenceImportException)
        {
            message = "That import batch was not found. Reload the page and try again.";
        }
        finally { legacyImportBusy = false; }
    }

    private async Task SaveSourceDocumentAsync()
    {
        if (pendingSource is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.CandidateSourceDocuments.Add(new CandidateSourceDocument
        {
            UserId = userId,
            FileName = pendingSource.FileName,
            Kind = pendingSource.Kind,
            MediaType = pendingSource.MediaType,
            SourceSha256 = pendingSource.SourceSha256,
            ExtractedText = pendingSource.ExtractedText,
            ReviewNotes = pendingSource.ReviewNotes
        });
        await db.SaveChangesAsync();
        pendingSource = null;
        message = "Document text imported. Review suggested facts to add them to your profile or evidence library.";
        await ReloadAsync();
    }

    private void ReviewSourceFacts(CandidateSourceDocument source)
    {
        mappingSourceId = source.Id;
        mappingSourceName = source.FileName;
        mappingSourceHash = source.SourceSha256;
        var suggestions = CandidateFactMapper.Suggest(source.ExtractedText);
        mappingEmail = suggestions.Email;
        mappingPhone = suggestions.Phone;
        mappingSummary = suggestions.Summary;
        mappingClaims = suggestions.Claims.Select(claim => new EvidenceSuggestionDraft { Claim = claim }).ToList();
        message = "Review and edit suggestions before using them.";
    }

    private void ApplyProfileSuggestions()
    {
        if (!string.IsNullOrWhiteSpace(mappingEmail)) profile.Email = mappingEmail.Trim();
        if (!string.IsNullOrWhiteSpace(mappingPhone)) profile.Phone = mappingPhone.Trim();
        if (!string.IsNullOrWhiteSpace(mappingSummary)) profile.Summary = mappingSummary.Trim();
        message = "Suggested details copied into the profile draft. Review and save the profile above.";
    }

    private async Task AddSuggestedEvidenceAsync(EvidenceSuggestionDraft suggestion)
    {
        if (profile.Id == 0 || suggestion.Added) return;
        var claim = suggestion.Claim.Trim();
        var kind = suggestion.Kind.Trim();
        var keywords = suggestion.Keywords.Trim();
        var details = suggestion.Details.Trim();
        if (claim.Length is < 1 or > 240 || kind.Length is < 1 or > 80 || keywords.Length > 1000 || details.Length > 3700)
        {
            message = "Check the evidence lengths: claim 1–240, kind 1–80, keywords up to 1000, and details up to 3700 characters.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (!await db.CandidateSourceDocuments.AnyAsync(source => source.Id == mappingSourceId && source.UserId == userId))
        {
            message = "The imported source could not be found.";
            return;
        }
        db.EvidenceItems.Add(new EvidenceItem
        {
            ProfileId = profile.Id,
            Kind = kind,
            Claim = claim,
            Keywords = keywords,
            Details = $"{details}\nSource: {mappingSourceName} (SHA-256: {mappingSourceHash})".Trim()
        });
        await db.SaveChangesAsync();
        suggestion.Added = true;
        message = "Reviewed evidence claim added.";
        await ReloadAsync();
    }

