@page "/studio"
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IFitScorer FitScorer
@inject ICareerDocumentService Documents
@inject ICandidateDocumentImportService DocumentImporter
@inject IClientDocumentExport ClientExport
@inject IJobDiscoveryService JobDiscovery

<PageTitle>Career studio</PageTitle>

<h1>Career studio</h1>
<p class="text-secondary">Your drafts stay reviewable. Export is blocked until you explicitly approve a version.</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<section class="studio-panel">
    <h2>Standard profile</h2>
    <EditForm Model="profile" OnValidSubmit="SaveProfileAsync" FormName="profile">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="profile-grid">
            <label>Title<InputText @bind-Value="profile.Title" /></label>
            <label>First name<InputText @bind-Value="profile.FirstName" /></label>
            <label>Middle initial(s)<InputText @bind-Value="profile.MiddleInitials" /></label>
            <label>Last name<InputText @bind-Value="profile.LastName" /></label>
            <label>Suffix<InputText @bind-Value="profile.Suffix" /></label>
            <label>Preferred display name<InputText @bind-Value="profile.PreferredDisplayName" /></label>
            <label>Email<InputText @bind-Value="profile.Email" /></label>
            <label>Phone<InputText @bind-Value="profile.Phone" /></label>
        </div>
        <label>Professional summary<InputTextArea @bind-Value="profile.Summary" rows="4" /></label>
        <button class="btn btn-primary" type="submit">Save profile</button>
    </EditForm>
</section>

<section class="studio-panel">
    <h2>Evidence library</h2>
    <EditForm Model="newEvidence" OnValidSubmit="AddEvidenceAsync" FormName="evidence">
        <DataAnnotationsValidator />
        <div class="profile-grid">
            <label>Kind<InputText @bind-Value="newEvidence.Kind" /></label>
            <label>Keywords (comma separated)<InputText @bind-Value="newEvidence.Keywords" /></label>
        </div>
        <label>Evidence claim<InputText @bind-Value="newEvidence.Claim" /></label>
        <label>Details<InputTextArea @bind-Value="newEvidence.Details" rows="3" /></label>
        <button class="btn btn-outline-primary" type="submit">Add evidence</button>
    </EditForm>
    <ul class="evidence-list">
        @foreach (var item in profile.Evidence)
        {
            <li><strong>@item.Claim</strong><span>@item.Kind · @item.Keywords</span></li>
        }
    </ul>
</section>

<section class="studio-panel">
    <h2>Import your documents</h2>
    <p>Bring in a TXT, DOCX, or text-based PDF résumé, cover letter, or other source document (up to 2 MB). Review the extracted text before saving it. The original file stays on your computer.</p>
    <label>Document type
        <select class="form-select" @bind="sourceKind">
            <option value="resume">Résumé</option>
            <option value="cover-letter">Cover letter</option>
            <option value="other">Other</option>
        </select>
    </label>
    <InputFile OnChange="PreviewSourceDocumentAsync" accept=".txt,.docx,.pdf" />
    @if (pendingSource is not null)
    {
        <div class="mt-3">
            <h3>Review @pendingSource.FileName</h3>
            @if (!string.IsNullOrEmpty(pendingSource.ReviewNotes))
            {
                <p class="text-warning">Extraction notes: @pendingSource.ReviewNotes. Check the text against the original.</p>
            }
            <pre class="document-preview">@pendingSource.ExtractedText</pre>
            <button class="btn btn-primary" type="button" @onclick="SaveSourceDocumentAsync">Save imported text</button>
        </div>
    }
    @foreach (var source in sourceDocuments)
    {
        <details class="mt-3">
            <summary>@source.FileName · @source.Kind · imported @source.ImportedAt.ToLocalTime().ToString("g")</summary>
            @if (!string.IsNullOrEmpty(source.ReviewNotes))
            {
                <p class="text-warning">Extraction notes: @source.ReviewNotes</p>
            }
            <pre class="document-preview">@source.ExtractedText</pre>
        </details>
    }
</section>

<section class="studio-panel">
    <h2>Find matching remote jobs</h2>
    <p>Fetch current Remote OK postings and compare them with your saved evidence on this computer. Your profile is not sent to the job board.</p>
    <button class="btn btn-primary" type="button" disabled="@(isSearching || profile.Id == 0 || profile.Evidence.Count == 0)" @onclick="SearchRemoteJobsAsync">
        @(isSearching ? "Searching…" : "Find matching jobs")
    </button>
    @if (profile.Id == 0 || profile.Evidence.Count == 0)
    {
        <p class="text-secondary mt-2">Save a profile and at least one evidence item to search.</p>
    }
    @foreach (var result in discoveredJobs)
    {
        <article class="job-card mt-3">
            <div><h3>@result.RoleTitle</h3><p>@result.Organization</p></div>
            <div class="fit-score"><strong>@result.FitScore.ToString("P0")</strong><span>local fit signal</span></div>
            <p class="fit-explanation">@result.FitExplanation</p>
            <p><a href="@result.SourceUrl" target="_blank" rel="noopener noreferrer">View original posting on Remote OK</a></p>
            <button class="btn btn-sm btn-primary" type="button" @onclick="() => DraftDiscoveredJobAsync(result)">Create drafts for this job</button>
        </article>
    }
</section>

<section class="studio-panel">
    <h2>Import another opportunity</h2>
    <p>Paste a posting or use this browser-assist bookmarklet on a job page, then paste the copied text here:</p>
    <a class="bookmarklet" href="javascript:(()=>navigator.clipboard.writeText(document.title+'%0A'+location.href+'%0A%0A'+getSelection().toString()))()">Copy selected job</a>
    <EditForm Model="newJob" OnValidSubmit="AddJobAsync" FormName="job">
        <DataAnnotationsValidator />
        <div class="profile-grid">
            <label>Role title<InputText @bind-Value="newJob.RoleTitle" /></label>
            <label>Organization<InputText @bind-Value="newJob.Organization" /></label>
            <label>Source URL<InputText @bind-Value="newJob.SourceUrl" /></label>
        </div>
        <label>Job description<InputTextArea @bind-Value="newJob.Description" rows="10" /></label>
        <button class="btn btn-primary" type="submit">Analyze and draft</button>
    </EditForm>
</section>

<section class="studio-panel">
    <h2>Application tracker</h2>
    @foreach (var job in jobs)
    {
        <article class="job-card">
            <div><p class="eyebrow">@job.Status</p><h3>@job.RoleTitle</h3><p>@job.Organization</p></div>
            <div class="fit-score"><strong>@job.FitScore.ToString("P0")</strong><span>local fit signal</span></div>
            <p class="fit-explanation">@job.FitExplanation</p>
            @foreach (var document in job.Documents.OrderBy(document => document.Kind))
            {
                <details>
                    <summary>@document.Kind · version @document.Version · @(document.ApprovedAt is null ? "review required" : "approved")</summary>
                    <pre>@document.Content</pre>
                    @if (document.ApprovedAt is null)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => ApproveAsync(document.Id)">Approve this version</button>
                    }
                    else
                    {
                        @if (ClientExport.IsAvailable)
                        {
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => ExportDocxAsync(document.Id)">Save DOCX</button>
                            <span> · </span>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => ExportPdfAsync(document.Id)">Save PDF</button>
                        }
                        else
                        {
                            <a href="@($"/documents/{document.Id}/docx")">DOCX</a><span> · </span><a href="@($"/documents/{document.Id}/pdf")">PDF</a>
                        }
                    }
                </details>
            }
            <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkSubmittedAsync(job.Id)">Record manual submission</button>
        </article>
    }
</section>

@code {
    private CandidateProfile profile = new();
    private EvidenceItem newEvidence = new();
    private JobOpportunity newJob = new();
    private List<JobOpportunity> jobs = [];
    private List<CandidateSourceDocument> sourceDocuments = [];
    private CandidateDocumentImport? pendingSource;
    private string sourceKind = "resume";
    private IReadOnlyList<DiscoveredJob> discoveredJobs = [];
    private bool isSearching;
    private string userId = "";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        profile = await db.CandidateProfiles.Include(item => item.Evidence).SingleOrDefaultAsync(item => item.UserId == userId)
            ?? new CandidateProfile { UserId = userId };
        jobs = (await db.JobOpportunities.Include(job => job.Documents).Include(job => job.Activities)
            .Where(job => job.UserId == userId).ToListAsync())
            .OrderByDescending(job => job.ImportedAt).ToList();
        sourceDocuments = (await db.CandidateSourceDocuments.Where(source => source.UserId == userId).ToListAsync())
            .OrderByDescending(source => source.ImportedAt).ToList();
    }

    private async Task PreviewSourceDocumentAsync(InputFileChangeEventArgs eventArgs)
    {
        pendingSource = null;
        try
        {
            var file = eventArgs.File;
            await using var stream = file.OpenReadStream(CandidateDocumentImportService.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            pendingSource = await DocumentImporter.ExtractAsync(file.Name, sourceKind, buffer.ToArray());
            message = "Review the extracted text before saving it.";
        }
        catch (DocumentImportException exception)
        {
            message = exception.Code switch
            {
                "SIZE_LIMIT" => "Choose a nonempty file no larger than 2 MB.",
                "NO_TEXT" => "No text was found. Scanned PDFs need OCR before they can be imported.",
                _ => "This document could not be read. Check that it is a valid TXT, DOCX, or text-based PDF."
            };
        }
        catch (Exception exception) when (exception is IOException or InvalidOperationException or ArgumentException)
        {
            message = "Choose a valid TXT, DOCX, or text-based PDF no larger than 2 MB.";
        }
    }

    private async Task SaveSourceDocumentAsync()
    {
        if (pendingSource is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.CandidateSourceDocuments.Add(new CandidateSourceDocument
        {
            UserId = userId,
            FileName = pendingSource.FileName,
            Kind = pendingSource.Kind,
            MediaType = pendingSource.MediaType,
            SourceSha256 = pendingSource.SourceSha256,
            ExtractedText = pendingSource.ExtractedText,
            ReviewNotes = pendingSource.ReviewNotes
        });
        await db.SaveChangesAsync();
        pendingSource = null;
        message = "Document text imported. Review and copy relevant facts into your profile or evidence library.";
        await ReloadAsync();
    }

    private async Task SaveProfileAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (profile.Id == 0) db.CandidateProfiles.Add(profile); else db.CandidateProfiles.Update(profile);
        await db.SaveChangesAsync();
        message = "Profile saved.";
        await ReloadAsync();
    }

    private async Task AddEvidenceAsync()
    {
        if (profile.Id == 0) { message = "Save the profile before adding evidence."; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        newEvidence.ProfileId = profile.Id;
        db.EvidenceItems.Add(newEvidence);
        await db.SaveChangesAsync();
        newEvidence = new EvidenceItem();
        message = "Evidence added.";
        await ReloadAsync();
    }

    private async Task AddJobAsync()
    {
        if (profile.Id == 0 || profile.Evidence.Count == 0) { message = "Save a profile and at least one evidence item first."; return; }
        newJob.UserId = userId;
        newJob.Status = OpportunityStatus.ReadyForReview;
        var fit = FitScorer.Score(profile, newJob);
        newJob.FitScore = fit.Score;
        newJob.FitExplanation = fit.Explanation;
        newJob.Documents.Add(new DocumentVersion { Kind = CareerDocumentKind.Resume, Version = 1, Content = Documents.DraftResume(profile, newJob) });
        newJob.Documents.Add(new DocumentVersion { Kind = CareerDocumentKind.CoverLetter, Version = 1, Content = Documents.DraftCoverLetter(profile, newJob) });
        newJob.Activities.Add(new ApplicationActivity { Action = "drafted", Note = "Local fit analysis and document drafts created." });
        await using var db = await DbFactory.CreateDbContextAsync();
        db.JobOpportunities.Add(newJob);
        await db.SaveChangesAsync();
        newJob = new JobOpportunity();
        message = "Opportunity analyzed; review both drafts before approval.";
        await ReloadAsync();
    }

    private async Task SearchRemoteJobsAsync()
    {
        isSearching = true;
        message = "";
        try
        {
            discoveredJobs = await JobDiscovery.FindMatchesAsync(profile);
            if (discoveredJobs.Count == 0) message = "No matching remote jobs were available from Remote OK right now.";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            message = "Job search is temporarily unavailable. Try again later or import a posting below.";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task DraftDiscoveredJobAsync(DiscoveredJob result)
    {
        newJob = new JobOpportunity
        {
            RoleTitle = result.RoleTitle,
            Organization = result.Organization,
            SourceUrl = result.SourceUrl,
            Description = result.Description
        };
        await AddJobAsync();
        discoveredJobs = [];
    }

    private async Task ApproveAsync(int documentId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var document = await db.DocumentVersions.Join(db.JobOpportunities, d => d.JobOpportunityId, j => j.Id, (d, j) => new { d, j.UserId })
            .SingleAsync(item => item.d.Id == documentId && item.UserId == userId);
        document.d.ApprovedAt = DateTimeOffset.UtcNow;
        document.d.ApprovedByUserId = userId;
        await db.SaveChangesAsync();
        message = "Version approved and available for export.";
        await ReloadAsync();
    }

    private Task ExportDocxAsync(int documentId) => ExportAsync(documentId, "docx");
    private Task ExportPdfAsync(int documentId) => ExportAsync(documentId, "pdf");

    private async Task ExportAsync(int documentId, string format)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var document = await db.DocumentVersions
            .Join(db.JobOpportunities, version => version.JobOpportunityId, job => job.Id,
                (version, job) => new { Version = version, job.UserId })
            .SingleOrDefaultAsync(item => item.Version.Id == documentId && item.UserId == userId);
        if (document?.Version.ApprovedAt is null)
        {
            message = "Approve this document version before export.";
            return;
        }
        var content = format == "pdf" ? Documents.ToPdf(document.Version.Content) : Documents.ToDocx(document.Version.Content);
        var mediaType = format == "pdf" ? "application/pdf" : "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        try
        {
            var saved = await ClientExport.SaveAsync(content, $"application-{documentId}.{format}", mediaType);
            message = saved ? "Document saved." : "Save canceled.";
        }
        catch (IOException)
        {
            message = "The document could not be saved at that location.";
        }
    }

    private async Task MarkSubmittedAsync(int jobId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var job = await db.JobOpportunities.Include(item => item.Documents).SingleAsync(item => item.Id == jobId && item.UserId == userId);
        if (job.Documents.Count < 2 || job.Documents.Any(document => document.ApprovedAt is null))
        {
            message = "Approve both document versions before recording a manual submission.";
            return;
        }
        job.Status = OpportunityStatus.Submitted;
        job.Activities.Add(new ApplicationActivity { Action = "submitted", Note = "User confirmed a manual external submission." });
        await db.SaveChangesAsync();
        message = "Manual submission recorded. No external form was automated.";
        await ReloadAsync();
    }
}
