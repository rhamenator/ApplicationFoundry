@page "/studio"
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IFitScorer FitScorer
@inject ICareerDocumentService Documents
@inject ICandidateDocumentImportService DocumentImporter
@inject LegacyAccessCsvPreviewService LegacyCsvPreviewer
@inject LegacyEvidenceImportService EvidenceImporter
@inject IClientDocumentExport ClientExport
@inject IJobDiscoveryService JobDiscovery
@inject GreenhouseJobDiscoveryService GreenhouseDiscovery
@inject LeverJobDiscoveryService LeverDiscovery
@inject IJSRuntime JS

<PageTitle>Career studio</PageTitle>

<h1>Career studio</h1>
<p class="text-secondary">Your drafts stay reviewable. Export is blocked until you explicitly approve a version.</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info">@message</div>
}

<section class="studio-panel">
    <h2>Standard profile</h2>
    <EditForm Model="profile" OnValidSubmit="SaveProfileAsync" FormName="profile">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="profile-grid">
            <label>Title<InputText @bind-Value="profile.Title" /></label>
            <label>First name<InputText @bind-Value="profile.FirstName" /></label>
            <label>Middle initial(s)<InputText @bind-Value="profile.MiddleInitials" /></label>
            <label>Last name<InputText @bind-Value="profile.LastName" /></label>
            <label>Suffix<InputText @bind-Value="profile.Suffix" /></label>
            <label>Preferred display name<InputText @bind-Value="profile.PreferredDisplayName" /></label>
            <label>Email<InputText @bind-Value="profile.Email" /></label>
            <label>Phone<InputText @bind-Value="profile.Phone" /></label>
        </div>
        <label>Professional summary<InputTextArea @bind-Value="profile.Summary" rows="4" /></label>
        <button class="btn btn-primary" type="submit">Save profile</button>
    </EditForm>
</section>

<section class="studio-panel">
    <h2>Evidence library</h2>
    <EditForm Model="newEvidence" OnValidSubmit="AddEvidenceAsync" FormName="evidence">
        <DataAnnotationsValidator />
        <div class="profile-grid">
            <label>Kind<InputText @bind-Value="newEvidence.Kind" /></label>
            <label>Keywords (comma separated)<InputText @bind-Value="newEvidence.Keywords" /></label>
        </div>
        <label>Evidence claim<InputText @bind-Value="newEvidence.Claim" /></label>
        <label>Details<InputTextArea @bind-Value="newEvidence.Details" rows="3" /></label>
        <button class="btn btn-outline-primary" type="submit">Add evidence</button>
    </EditForm>
    <ul class="evidence-list">
        @foreach (var item in profile.Evidence)
        {
            <li><strong>@item.Claim</strong><span>@item.Kind · @item.Keywords</span></li>
        }
    </ul>
</section>

<section class="studio-panel">
    <h2>Import your documents</h2>
    <p>Bring in a TXT, DOCX, or text-based PDF résumé, cover letter, or other source document (up to 2 MB). Review the extracted text before saving it. The original file stays on your computer.</p>
    <label>Document type
        <select class="form-select" @bind="sourceKind">
            <option value="resume">Résumé</option>
            <option value="cover-letter">Cover letter</option>
            <option value="other">Other</option>
        </select>
    </label>
    <InputFile OnChange="PreviewSourceDocumentAsync" accept=".txt,.docx,.pdf" />
    @if (pendingSource is not null)
    {
        <div class="mt-3">
            <h3>Review @pendingSource.FileName</h3>
            @if (!string.IsNullOrEmpty(pendingSource.ReviewNotes))
            {
                <p class="text-warning">Extraction notes: @pendingSource.ReviewNotes. Check the text against the original.</p>
            }
            <pre class="document-preview">@pendingSource.ExtractedText</pre>
            <button class="btn btn-primary" type="button" @onclick="SaveSourceDocumentAsync">Save imported text</button>
        </div>
    }
    @foreach (var source in sourceDocuments)
    {
        <details class="mt-3">
            <summary>@source.FileName · @source.Kind · imported @source.ImportedAt.ToLocalTime().ToString("g")</summary>
            @if (!string.IsNullOrEmpty(source.ReviewNotes))
            {
                <p class="text-warning">Extraction notes: @source.ReviewNotes</p>
            }
            <pre class="document-preview">@source.ExtractedText</pre>
            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => ReviewSourceFacts(source)">Review suggested facts</button>
        </details>
    }
    @if (mappingSourceId != 0)
    {
        <div class="mt-3">
            <h3>Review facts from @mappingSourceName</h3>
            <p>These are suggestions from the imported text. Edit them before using them; check every claim against the original document.</p>
            <div class="profile-grid">
                <label>Suggested email<input class="form-control" @bind="mappingEmail" /></label>
                <label>Suggested phone<input class="form-control" @bind="mappingPhone" /></label>
            </div>
            <label>Suggested professional summary<textarea class="form-control" rows="4" @bind="mappingSummary"></textarea></label>
            <button class="btn btn-outline-primary mt-2" type="button" @onclick="ApplyProfileSuggestions">Use in profile draft</button>
            <p class="text-secondary">Profile changes are saved when you select Save profile above.</p>
            <h4>Possible evidence claims</h4>
            @if (mappingClaims.Count == 0)
            {
                <p>No bullet claims were found. You can still add evidence manually above.</p>
            }
            @foreach (var suggestion in mappingClaims)
            {
                <div class="mt-3">
                    <label>Evidence claim<input class="form-control" @bind="suggestion.Claim" /></label>
                    <div class="profile-grid">
                        <label>Kind<input class="form-control" @bind="suggestion.Kind" /></label>
                        <label>Keywords (comma separated)<input class="form-control" @bind="suggestion.Keywords" /></label>
                    </div>
                    <label>Details<textarea class="form-control" rows="2" @bind="suggestion.Details"></textarea></label>
                    <button class="btn btn-sm btn-outline-primary mt-1" type="button" disabled="@(profile.Id == 0 || suggestion.Added)" @onclick="() => AddSuggestedEvidenceAsync(suggestion)">@(suggestion.Added ? "Added" : "Add to evidence")</button>
                </div>
            }
            @if (profile.Id == 0 && mappingClaims.Count > 0)
            {
                <p>Save the profile before adding evidence claims.</p>
            }
        </div>
    }
</section>

<section class="studio-panel">
    <h2>Preview an Access table export</h2>
    <p>Export one table from Access as UTF-8 CSV (up to 8 MB), then inspect its columns and first five records here. This preview stays in memory; it does not change your profile or import records.</p>
    <InputFile OnChange="PreviewLegacyCsvAsync" accept=".csv" />
    @if (pendingLegacyCsv is not null)
    {
        <div class="mt-3">
            <h3>@pendingLegacyCsv.FileName · @pendingLegacyCsv.RowCount records</h3>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr>@foreach (var column in pendingLegacyCsv.Columns) { <th>@column</th> }</tr></thead>
                    <tbody>
                        @foreach (var row in pendingLegacyCsv.SampleRows)
                        {
                            <tr>@foreach (var value in row) { <td>@value</td> }</tr>
                        }
                    </tbody>
                </table>
            </div>
            <h4>Map source columns</h4>
            <p>Choose at most one source column for each destination field, then preview the mapped sample. No records are saved.</p>
            <div class="profile-grid">
                @foreach (var draft in legacyColumnDrafts)
                {
                    <label>@draft.Column
                        <select class="form-select" @bind="draft.Target" @bind:after="ClearLegacyMappingPreview">
                            <option value="">Ignore</option>
                            <option value="first-name">First name</option>
                            <option value="last-name">Last name</option>
                            <option value="email">Email</option>
                            <option value="phone">Phone</option>
                            <option value="summary">Professional summary</option>
                            <option value="evidence-claim">Evidence claim</option>
                        </select>
                    </label>
                }
            </div>
            <button class="btn btn-outline-primary mt-2" type="button" @onclick="PreviewLegacyMapping">Preview mapping</button>
            @if (legacyMappedPreview is not null)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm">
                        <thead><tr>@foreach (var target in legacyMappedPreview.TargetFields) { <th>@target</th> }</tr></thead>
                        <tbody>
                            @foreach (var row in legacyMappedPreview.SampleRows)
                            {
                                <tr>@foreach (var target in legacyMappedPreview.TargetFields) { <td>@row[target]</td> }</tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button class="btn btn-outline-primary mt-2" type="button" @onclick="PrepareLegacyEvidenceImport">Prepare evidence import</button>
            }
            @if (legacyImportPlan is not null)
            {
                <p class="mt-3">Ready for review: @legacyImportPlan.Claims.Count unique evidence claims; @legacyImportPlan.EmptyOrDuplicateRows empty or duplicate rows skipped.</p>
                <details>
                    <summary>Review all @legacyImportPlan.Claims.Count claims before importing</summary>
                    <ol>@foreach (var claim in legacyImportPlan.Claims) { <li>@claim</li> }</ol>
                </details>
                <label class="mt-2"><input type="checkbox" @bind="legacyImportConfirmed" /> I reviewed every claim and want to add this batch to my evidence library.</label>
                <button class="btn btn-primary mt-2" type="button" disabled="@(!legacyImportConfirmed || profile.Id == 0 || legacyImportBusy)" @onclick="ImportLegacyEvidenceAsync">Import @legacyImportPlan.Claims.Count claims</button>
            }
        </div>
    }
    @if (legacyImportBatches.Count > 0)
    {
        <h3 class="mt-3">Imported evidence batches</h3>
        <ul>
            @foreach (var batch in legacyImportBatches)
            {
                <li>@batch.FileName · @batch.ClaimCount claims · @batch.ImportedAt.ToLocalTime().ToString("g")
                    <button class="btn btn-sm btn-outline-danger" type="button" disabled="@legacyImportBusy" @onclick="() => UndoLegacyEvidenceImportAsync(batch.Id)">Undo this import</button>
                </li>
            }
        </ul>
    }
</section>

<section class="studio-panel">
    <h2>Find matching jobs</h2>
    <p>Compare current postings with your saved evidence on this computer. Your profile is not sent to the job board.</p>
    <label>Job source
        <select class="form-select" @bind="searchSource">
            <option value="remoteok">Remote OK (remote roles)</option>
            <option value="greenhouse">Greenhouse employer board</option>
            <option value="lever">Lever employer site</option>
        </select>
    </label>
    @if (searchSource == "greenhouse")
    {
        <div class="profile-grid">
            <label>Employer name<input class="form-control" @bind="greenhouseEmployer" /></label>
            <label>Greenhouse board token<input class="form-control" @bind="greenhouseBoardToken" /></label>
            <label>Location contains (optional)<input class="form-control" @bind="searchLocation" /></label>
        </div>
        <p class="text-secondary">Use the final segment of the employer's Greenhouse board URL as its token. The employer name and token identify the board; your profile and filters stay local.</p>
    }
    @if (searchSource == "lever")
    {
        <div class="profile-grid">
            <label>Employer name<input class="form-control" @bind="leverEmployer" /></label>
            <label>Lever site token<input class="form-control" @bind="leverSiteToken" /></label>
            <label>Site region
                <select class="form-select" @bind="leverRegion">
                    <option value="global">Global</option>
                    <option value="eu">EU</option>
                </select>
            </label>
            <label>Location contains (optional)<input class="form-control" @bind="searchLocation" /></label>
        </div>
        <p class="text-secondary">Use the employer's Lever site name from its jobs.lever.co or jobs.eu.lever.co URL. Your profile and filters stay local.</p>
    }
    <div class="profile-grid">
        <label>Required keywords (comma separated)<input class="form-control" @bind="searchKeywords" /></label>
        <label>Minimum local fit
            <select class="form-select" @bind="minimumSearchFitPercent">
                <option value="0">Any fit</option>
                <option value="25">25%</option>
                <option value="50">50%</option>
                <option value="75">75%</option>
            </select>
        </label>
    </div>
    <p class="text-secondary">All keywords must appear in the posting. Filters are applied on this computer.</p>
    <button class="btn btn-primary" type="button" disabled="@(isSearching || profile.Id == 0 || profile.Evidence.Count == 0 || (searchSource == "greenhouse" && (string.IsNullOrWhiteSpace(greenhouseEmployer) || string.IsNullOrWhiteSpace(greenhouseBoardToken))) || (searchSource == "lever" && (string.IsNullOrWhiteSpace(leverEmployer) || string.IsNullOrWhiteSpace(leverSiteToken))))" @onclick="SearchJobsAsync">
        @(isSearching ? "Searching…" : "Find matching jobs")
    </button>
    @if (profile.Id == 0 || profile.Evidence.Count == 0)
    {
        <p class="text-secondary mt-2">Save a profile and at least one evidence item to search.</p>
    }
    @foreach (var result in discoveredJobs)
    {
        <article class="job-card mt-3">
            <div><h3>@result.RoleTitle</h3><p>@result.Organization @if (!string.IsNullOrWhiteSpace(result.Location)) { <span>· @result.Location</span> }</p></div>
            <div class="fit-score"><strong>@result.FitScore.ToString("P0")</strong><span>local fit signal</span></div>
            <p class="fit-explanation">@result.FitExplanation</p>
            <p><a href="@result.SourceUrl" target="_blank" rel="noopener noreferrer">View original posting on @result.SourceName</a></p>
            <button class="btn btn-sm btn-primary" type="button" @onclick="() => DraftDiscoveredJobAsync(result)">Create drafts for this job</button>
        </article>
    }
</section>

<section class="studio-panel">
    <h2>Import another opportunity</h2>
    <p>Paste a posting or use this browser-assist bookmarklet on a job page, then paste the copied text here:</p>
    <a class="bookmarklet" href="javascript:(()=>navigator.clipboard.writeText(document.title+'%0A'+location.href+'%0A%0A'+getSelection().toString()))()">Copy selected job</a>
    <EditForm Model="newJob" OnValidSubmit="AddJobAsync" FormName="job">
        <DataAnnotationsValidator />
        <div class="profile-grid">
            <label>Role title<InputText @bind-Value="newJob.RoleTitle" /></label>
            <label>Organization<InputText @bind-Value="newJob.Organization" /></label>
            <label>Source URL<InputText @bind-Value="newJob.SourceUrl" /></label>
        </div>
        <label>Job description<InputTextArea @bind-Value="newJob.Description" rows="10" /></label>
        <button class="btn btn-primary" type="submit">Analyze and draft</button>
    </EditForm>
</section>

<section class="studio-panel">
    <h2>Application tracker</h2>
    @foreach (var job in jobs)
    {
        <article class="job-card">
            <div><p class="eyebrow">@job.Status</p><h3>@job.RoleTitle</h3><p>@job.Organization</p></div>
            <div class="fit-score"><strong>@job.FitScore.ToString("P0")</strong><span>local fit signal</span></div>
            <p class="fit-explanation">@job.FitExplanation</p>
            @foreach (var document in job.Documents.OrderBy(document => document.Kind))
            {
                <details>
                    <summary>@document.Kind · version @document.Version · @(document.ApprovedAt is null ? "review required" : "approved")</summary>
                    <pre>@document.Content</pre>
                    @if (document.ApprovedAt is null)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => ApproveAsync(document.Id)">Approve this version</button>
                    }
                    else
                    {
                        @if (ClientExport.IsAvailable)
                        {
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => ExportDocxAsync(document.Id)">Save DOCX</button>
                            <span> · </span>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => ExportPdfAsync(document.Id)">Save PDF</button>
                        }
                        else
                        {
                            <a href="@($"/documents/{document.Id}/docx")">DOCX</a><span> · </span><a href="@($"/documents/{document.Id}/pdf")">PDF</a>
                        }
                    }
                </details>
            }
            <details class="mt-2">
                <summary>Application form preparation · @(job.FormPlan is null ? "not started" : job.FormPlan.Mode.ToString())</summary>
                <p class="mt-2">Prepare answers for this employer's form and choose your submission preference. The browser helper can fill exact values after your authorization; it never submits the form.</p>
                <label>Submission preference
                    <select class="form-select" @bind="formDrafts[job.Id].Mode">
                        <option value="SubmitPersonally">Review and submit personally</option>
                        <option value="ApproveEachSubmission">Approve each submission</option>
                        <option value="AutomaticWithinRules">Automatic submission within my rules</option>
                    </select>
                </label>
                <label>My submission rules<textarea class="form-control" rows="2" @bind="formDrafts[job.Id].Rules"></textarea></label>
                @if (formDrafts[job.Id].Mode == FormSubmissionMode.AutomaticWithinRules)
                {
                    <p class="text-secondary">For the local automatic-rule check, enter one rule per line: <code>organization=Employer name</code> and <code>minimum-fit=50</code>. Other or repeated rules block the check. This check does not inspect or send an employer form.</p>
                }
                <button class="btn btn-sm btn-outline-primary mt-2" type="button" @onclick="() => SaveFormPlanAsync(job.Id)">Save preference</button>
                @if (job.FormPlan?.Mode == FormSubmissionMode.AutomaticWithinRules)
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2" type="button" @onclick="() => CheckAutomaticRules(job.Id)">Check automatic rules locally</button>
                    @if (ruleResults.TryGetValue(job.Id, out var result))
                    {
                        <p class="mt-2"><strong>@(result.MatchesLocalRules ? "Local rules match" : "Local rules block this opportunity")</strong> · No employer form was inspected or sent.</p>
                        @foreach (var reason in result.Reasons)
                        {
                            <p>@reason</p>
                        }
                    }
                }
                <h4 class="mt-3">Prepared answers</h4>
                @if (job.FormPlan is not null)
                {
                    @foreach (var answer in job.FormPlan.Answers.OrderBy(answer => answer.Id))
                    {
                        <p><strong>@answer.FieldLabel:</strong> @answer.Answer <span class="text-secondary">· source: @answer.Source · reviewed @answer.ReviewedAt.ToLocalTime().ToString("g")</span></p>
                    }
                }
                <div class="profile-grid">
                    <label>Form question or field<input class="form-control" @bind="formDrafts[job.Id].FieldLabel" /></label>
                    <label>Source of this answer<input class="form-control" @bind="formDrafts[job.Id].Source" /></label>
                </div>
                <label>Answer<textarea class="form-control" rows="3" @bind="formDrafts[job.Id].Answer"></textarea></label>
                <div class="mt-2">
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => UseProfileFact(job.Id, ProfileFact.FullName)">Use saved name</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => UseProfileFact(job.Id, ProfileFact.Email)">Use saved email</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => UseProfileFact(job.Id, ProfileFact.Phone)">Use saved phone</button>
                </div>
                <button class="btn btn-sm btn-outline-primary mt-2" type="button" @onclick="() => AddPreparedAnswerAsync(job.Id)">Save reviewed answer</button>
                <h4 class="mt-3">Preview a form match</h4>
                <p>Drag this link to your browser bookmarks. On the employer's application form, use the bookmark to copy its structure, then paste it below. It reads field labels and choices, never your entered values. The preview stays on this computer and does not enter or send values.</p>
                <a class="bookmarklet" href="@EmployerFormSnapshotBookmarklet.Href">Copy form structure</a>
                <details><summary>Form snapshot format</summary><pre>{"url":"https://example.test/apply","fields":[{"key":"email","label":"Email","type":"email","required":true}]}</pre></details>
                <label>Form snapshot JSON<textarea class="form-control" rows="4" maxlength="65536" @bind="formDrafts[job.Id].SnapshotJson" @bind:event="oninput"></textarea></label>
                <button class="btn btn-sm btn-outline-secondary mt-2" type="button" @onclick="() => PreviewFormMatch(job.Id)">Preview reviewed answers</button>
                @if (formDrafts[job.Id].FormPreview is { } preview)
                {
                    <p class="mt-2"><strong>@(preview.IsComplete ? "Ready to review" : "Cannot safely match this form")</strong></p>
                    @foreach (var reason in preview.Reasons)
                    {
                        <p>@reason</p>
                    }
                    @foreach (var value in preview.Values)
                    {
                        <p><strong>@value.Label:</strong> @value.Value</p>
                    }
                    @if (preview.IsComplete)
                    {
                        <p>Review these exact values before authorizing a fill attempt. Authorization lasts ten minutes and is lost if the form or reviewed packet changes. Authorizing alone does not fill or submit the form.</p>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => AuthorizeFormMatchAsync(job.Id)">Authorize these proposed values</button>
                        @if (IsFormMatchAuthorized(job))
                        {
                            <p class="mt-2">Authorized for this exact form match until @formDrafts[job.Id].FormAuthorization!.AuthorizedAt.Add(FormFillAuthorizer.MaxAge).ToLocalTime().ToString("g"). No values were entered or sent.</p>
                            <p>Drag this fill link to your browser bookmarks once. Then copy the approved packet and use that bookmark on the same employer form. The clipboard will contain your reviewed answers until replaced. Inspect the filled form before submitting it yourself.</p>
                            <a class="bookmarklet" href="@EmployerFormFillBookmarklet.Href">Fill approved values</a>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => CopyApprovedFillPacketAsync(job.Id)">Copy approved fill packet</button>
                        }
                    }
                }
                <h4 class="mt-3">Values entered in the employer form</h4>
                <p>After the browser helper fills the form, inspect every value on the employer page. Paste its entry receipt here to review and record what was entered. Recording does not submit the form.</p>
                @if (job.Status != OpportunityStatus.Submitted)
                {
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => PasteBrowserReceiptAsync(job.Id)">Paste browser receipt from clipboard</button>
                    <label>Browser entry receipt<textarea class="form-control" rows="3" maxlength="512000" @bind="formDrafts[job.Id].BrowserReceiptJson"></textarea></label>
                    <button class="btn btn-sm btn-outline-secondary mt-2" type="button" @onclick="() => PreviewBrowserReceiptAsync(job.Id)">Review browser receipt</button>
                    @if (formDrafts[job.Id].ReceiptPreviewValues is { Count: > 0 } receiptValues)
                    {
                        <p class="mt-2">The browser receipt reports these exact values as entered:</p>
                        @foreach (var value in receiptValues)
                        {
                            <p><strong>@value.Label:</strong> @value.Value</p>
                        }
                        <label><input type="checkbox" @bind="formDrafts[job.Id].ConfirmObservedEntries" /> I inspected the employer form and confirm these exact values are present.</label>
                        <button class="btn btn-sm btn-outline-primary mt-2" type="button" @onclick="() => RecordBrowserReceiptAsync(job.Id)">Record these entered values</button>
                    }
                }
                <p>You can also record a field yourself after checking it on the employer page.</p>
                @if (job.FormPlan is not null)
                {
                    @foreach (var entry in job.FormPlan.Entries.OrderBy(entry => entry.Id))
                    {
                        <p><strong>@entry.FieldLabel:</strong> @entry.ValueEntered <span class="text-secondary">· @(entry.SubmittedAt is null ? "entered, not confirmed sent" : $"confirmed sent {entry.SubmittedAt.Value.ToLocalTime():g}")</span>
                            @if (entry.SubmittedAt is null)
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => RemoveEnteredFieldAsync(job.Id, entry.Id)">Remove</button>
                            }
                        </p>
                    }
                }
                @if (job.Status != OpportunityStatus.Submitted)
                {
                    <div class="profile-grid">
                        <label>Field entered<input class="form-control" @bind="formDrafts[job.Id].EntryFieldLabel" /></label>
                        <label>Exact value entered<textarea class="form-control" rows="2" @bind="formDrafts[job.Id].EntryValue"></textarea></label>
                    </div>
                    <button class="btn btn-sm btn-outline-primary mt-2" type="button" @onclick="() => RecordEnteredFieldAsync(job.Id)">Record entered value</button>
                }
                @if (job.FormPlan?.Mode == FormSubmissionMode.ApproveEachSubmission)
                {
                    <h4 class="mt-3">Submission approval</h4>
                    <p>Review the employer, approved document versions, and exact form values above. Approval applies only to this snapshot; changing any of them requires another approval. This app still does not send the employer form.</p>
                    <p>@(SubmissionApproval.IsCurrent(job) ? $"Approved {job.FormPlan.SubmissionApprovedAt!.Value.ToLocalTime():g}" : "Approval required for the current submission packet")</p>
                    @if (job.Status != OpportunityStatus.Submitted)
                    {
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => ApproveSubmissionAsync(job.Id)">Approve this submission packet</button>
                    }
                }
            </details>
            @if (job.FormPlan?.Entries.Count > 0 && job.Status != OpportunityStatus.Submitted)
            {
                <label><input type="checkbox" @bind="formDrafts[job.Id].ConfirmSentEntries" /> I confirm the recorded field values are exactly what I sent to this employer.</label>
            }
            <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkSubmittedAsync(job.Id)">Record manual submission</button>
            <details class="mt-3">
                <summary>Follow-up · @(job.NextFollowUpOn is null ? "none scheduled" : job.NextFollowUpOn.Value.ToString("d"))</summary>
                <p class="mt-2">Plan your next contact and keep a local record of what you did.</p>
                <label>Next follow-up date<input class="form-control" type="date" @bind="followUpDrafts[job.Id].DueOn" /></label>
                <button class="btn btn-sm btn-outline-primary mt-2" type="button" @onclick="() => ScheduleFollowUpAsync(job.Id)">Schedule follow-up</button>
                @if (job.NextFollowUpOn is not null)
                {
                    <button class="btn btn-sm btn-outline-secondary mt-2" type="button" @onclick="() => ClearFollowUpAsync(job.Id)">Clear date</button>
                }
                <label class="mt-3">Follow-up note<textarea class="form-control" rows="2" @bind="followUpDrafts[job.Id].Note"></textarea></label>
                <button class="btn btn-sm btn-outline-primary mt-2" type="button" @onclick="() => RecordFollowUpAsync(job.Id)">Record follow-up</button>
                @foreach (var activity in job.Activities.OrderByDescending(activity => activity.OccurredAt))
                {
                    <p class="mt-2"><strong>@activity.Action</strong> · @activity.OccurredAt.ToLocalTime().ToString("g") · @activity.Note</p>
                }
            </details>
        </article>
    }
</section>

